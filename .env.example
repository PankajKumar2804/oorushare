# OoruShare environment variables
# Copy to .env and fill in values before running.
#
# Without DATABASE_URL the server uses an in-memory store (no DB required).
# Without REDIS_URL    the server uses an in-process EventEmitter (no Redis required).

# ── Database ──────────────────────────────────────────────────────────────────
# Omit to use the in-memory fallback (demo / dev only — data lost on restart)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oorushare

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for SSE fan-out across multiple Node instances.
# Omit to use the in-process EventEmitter (single-instance only).
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Set to "1" to enable Node cluster mode (forks one worker per CPU core).
# Do NOT combine with docker compose --scale > 1 (use one or the other).
NODE_CLUSTER=0

# Number of cluster workers (default: os.cpus().length)
# CLUSTER_WORKERS=4

# How often the SSE broadcaster queries the DB and pushes live data (ms)
SSE_INTERVAL_MS=3000

# ── PostgreSQL pool (per Node process) ───────────────────────────────────────
# When PgBouncer is in front, keep POOL_MAX low (5-10).
# Without PgBouncer a good starting point is 20.
POOL_MAX=20
POOL_IDLE_MS=30000
POOL_CONNECT_MS=5000
POOL_STATEMENT_MS=10000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_WINDOW_MS=60000
RATE_API_MAX=300
RATE_BOOK_MAX=10
